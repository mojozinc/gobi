# ==========================================
# Gobi Backend API - Environment Configuration
# ==========================================

# Environment & Server
ENV=development
LOG_LEVEL=DEBUG
PORT=8000

# ------------------------------------------
# OPTION 1: Local Docker Postgres (Default)
# ------------------------------------------
DATABASE_URL=postgresql+asyncpg://gobi:gobi_password@localhost:5432/gobi_db

# ------------------------------------------
# OPTION 2: Supabase Cloud Postgres
# (Get from Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI)
# ------------------------------------------
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require

# ------------------------------------------
# OPTION 3: Local Supabase CLI Stack
# (Run `supabase start` in terminal)
# ------------------------------------------
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# JWT Secret
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRY_HOURS=72

# OpenRouter AI
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
